.Rproj.user
.Rhistory
.RData
.Ruserdata
codex/
.RDataTmp
.DS_Store
.Rapp.history

# Knitted output — regenerate by knitting the .Rmd, don't commit
*.html
*_files/
*.knit.md
*.utf8.md
fits/
*_cache/

# Figures as the notebooks write them. The copies the report actually uses
# live in report_backup/img/, so these are regenerable output, not sources.
figs/

# Report backup: LaTeX sources, figures and the compiled main.pdf are tracked,
# so the Overleaf project can be rebuilt from the repo alone and everyone can
# read the current report without compiling it (see report_backup/README.md).
# LaTeX build intermediates are not.
report_backup/*.aux
report_backup/*.log
report_backup/*.out
report_backup/*.bbl
report_backup/*.bcf
report_backup/*.blg
report_backup/*.toc
report_backup/*.fls
report_backup/*.fdb_latexmk
report_backup/*.run.xml
report_backup/*.synctex.gz
